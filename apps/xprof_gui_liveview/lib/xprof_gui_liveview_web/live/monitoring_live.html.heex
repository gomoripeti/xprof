<div class="min-h-screen bg-base-200">
  <%!-- Navbar --%>
  <nav class="navbar bg-neutral text-neutral-content shadow-lg fixed top-0 z-50">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost normal-case text-xl">
        <img
          src={get_icon_path(@mode)}
          alt="XProf"
          class="w-10 h-10 mr-2"
        />
        <span class="font-bold text-white">XPROF</span>
      </a>
    </div>

    <div class="flex-none flex items-center gap-4">
      <%!-- Trace Status Toggle --%>
      <button
        phx-click="toggle_trace"
        class={[
          "btn btn-sm gap-2",
          if(@trace_status == "running", do: "btn-error", else: "btn-success")
        ]}
        title={if @trace_status == "running", do: "Pause tracing", else: "Start tracing"}
      >
        <%= if @trace_status == "running" do %>
          <.icon name="hero-pause-solid" class="w-4 h-4" />
          <span>Pause Tracing</span>
        <% else %>
          <.icon name="hero-play-solid" class="w-4 h-4" />
          <span>Start Tracing</span>
        <% end %>
      </button>

      <%!-- Input Group: Switcher + Search Input --%>
      <div class="form-control relative">
        <div class="join">
          <%!-- Favourites Button --%>
          <button
            type="button"
            phx-click="toggle_input_type"
            phx-value-type="favourites"
            class="btn btn-sm join-item border-0 transition-colors"
            style={
              if @input_type == :favourites do
                "background-color: #798d8f; color: #fff;"
              else
                "background-color: #95a5a6; color: #fff;"
              end
            }
            onmouseover={unless @input_type == :favourites, do: "this.style.backgroundColor='#798d8f'"}
            onmouseout={unless @input_type == :favourites, do: "this.style.backgroundColor='#95a5a6'"}
            disabled={@input_type == :favourites}
            title="Favourites"
          >
            <.icon name="hero-star" class="w-5 h-5" />
          </button>

          <%!-- Search Button --%>
          <button
            type="button"
            phx-click="toggle_input_type"
            phx-value-type="search"
            class="btn btn-sm join-item border-0 transition-colors"
            style={
              if @input_type == :search do
                "background-color: #798d8f; color: #fff;"
              else
                "background-color: #95a5a6; color: #fff;"
              end
            }
            onmouseover={unless @input_type == :search, do: "this.style.backgroundColor='#798d8f'"}
            onmouseout={unless @input_type == :search, do: "this.style.backgroundColor='#95a5a6'"}
            disabled={@input_type == :search}
            title="Search"
          >
            <.icon name="hero-magnifying-glass" class="w-5 h-5" />
          </button>

          <%!-- Search Input --%>
          <form phx-submit="submit_query" class="join-item">
            <input
              type="text"
              placeholder="Hello BEAMer! Search your favourites queries."
              class="input input-sm w-[500px] bg-base-100 text-base-content border-base-300"
              value={@query}
              phx-change="update_query"
              phx-keydown="key_down"
              name="query"
              autocomplete="off"
              id="query-input"
              data-position={@position}
              data-has-suggestions={length(@functions) > 0}
              phx-hook="SearchInput"
            />
          </form>
        </div>

        <%!-- Autocomplete Dropdown --%>
        <%= if length(@functions) > 0 do %>
          <div class="absolute top-full mt-1 w-[500px] bg-base-100 shadow-lg rounded-lg max-h-64 overflow-y-auto z-50" style="left: 68px;">
            <ul class="menu menu-compact text-base-content">
              <%= for {func, index} <- Enum.with_index(@functions) do %>
                <li>
                  <a
                    phx-click="select_function"
                    phx-value-index={index}
                    class={if @position == index, do: "bg-primary text-primary-content", else: ""}
                  >
                    <code class="text-xs"><%= func.label || func.value %></code>
                  </a>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>

      <%!-- Grid Selector --%>
      <div class="dropdown dropdown-end">
        <label
          tabindex="0"
          phx-keydown="switch_grid_key"
          class="btn btn-sm border-0 transition-colors"
          style="background-color: #95a5a6; color: #fff;"
          onmouseover="this.style.backgroundColor='#798d8f'"
          onmouseout="this.style.backgroundColor='#95a5a6'"
        >
          <.icon name="hero-squares-2x2" class="w-5 h-5" />
        </label>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-32 text-base-content">
          <%= for grid_size <- [1, 2, 3, 4] do %>
            <li>
              <a phx-click="switch_grid" phx-value-grid={grid_size} class={if @grid == grid_size, do: "active"}>
                <%= grid_size %> column<%= if grid_size > 1, do: "s" %>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <%!-- Main Content Area (with padding for fixed navbar) --%>
  <main class="pt-20 px-4 pb-8">
    <%!-- Flash Messages --%>
    <.flash kind={:info} flash={@flash} />
    <.flash kind={:error} flash={@flash} />

    <%= if length(@monitored_functions) == 0 do %>
      <%!-- Welcome / Empty State --%>
      <div class="hero min-h-[60vh]">
        <div class="hero-content text-center">
          <div class="max-w-2xl">
            <h1 class="text-5xl font-bold mb-4">Welcome to XProf</h1>
            <p class="text-lg mb-8">
              Start monitoring Erlang/Elixir functions in real-time.
              Enter a function name in the search box above to begin.
            </p>
            <div class="alert alert-info">
              <.icon name="hero-information-circle" class="w-6 h-6" />
              <div class="text-left">
                <h3 class="font-bold">Quick Start:</h3>
                <ul class="list-disc list-inside mt-2">
                  <li>Type a function name (e.g., <code>lists:map/2</code>)</li>
                  <li>Use <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">I</kbd> to toggle between search and favourites</li>
                  <li>Use <kbd class="kbd kbd-sm">↑</kbd> / <kbd class="kbd kbd-sm">↓</kbd> to navigate autocomplete</li>
                  <li>Press <kbd class="kbd kbd-sm">Enter</kbd> to start monitoring</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <%!-- Monitored Functions Grid --%>
      <div class="grid gap-4" style={"grid-template-columns: repeat(#{@grid}, minmax(0, 1fr))"}>
        <%= for monitored <- @monitored_functions do %>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h2 class="card-title text-sm font-mono">
                    <%= format_mfa(monitored.mfa) %>
                  </h2>
                  <div class="text-xs text-base-content/70">
                    <%= monitored.query %>
                  </div>
                </div>
                <div class="flex gap-2">
                  <button
                    phx-click="add_to_favourites"
                    phx-value-query={monitored.query}
                    class="btn btn-xs btn-ghost"
                    title="Add to favourites"
                  >
                    <.icon name="hero-star" class="w-4 h-4" />
                  </button>
                  <button
                    phx-click="show_callees"
                    phx-value-mfa={monitored.mfa_str}
                    class="btn btn-xs btn-ghost"
                    title="Show called functions"
                  >
                    <.icon name="hero-arrow-right-circle" class="w-4 h-4" />
                  </button>
                  <button
                    phx-click="demonitor"
                    phx-value-mfa={monitored.mfa_str}
                    class="btn btn-xs btn-ghost"
                    title="Stop monitoring"
                  >
                    <.icon name="hero-x-mark" class="w-4 h-4" />
                  </button>
                </div>
              </div>
              <%!-- Graph Display --%>
              <div class="bg-base-200 rounded-lg mt-4 overflow-hidden">
                <%= if @charts[monitored.mfa_str] do %>
                  <div class="p-4">
                    <div
                      id={"chart-#{monitored.mfa_str |> String.replace([":", "/"], "-")}"}
                      phx-hook="ApexChart"
                      data-chart={Jason.encode!(@charts[monitored.mfa_str])}
                    >
                    </div>
                  </div>
                <% else %>
                  <div class="flex items-center justify-center h-64">
                    <span class="text-base-content/50 text-sm">Loading graph data...</span>
                  </div>
                <% end %>
              </div>


              <%!-- Capture Section (Collapsible) --%>
              <div
                id={"capture-#{monitored.mfa_str |> String.replace([":", "/"], "-")}"}
                class="collapse collapse-arrow bg-base-200 mt-4"
                phx-hook="Collapse"
              >
                <input type="checkbox" />
                <div class="collapse-title text-sm font-semibold">
                  Slow Calls Tracing
                </div>
                <div class="collapse-content">
                  <div class="mb-4">
                <%= if @capture_data[monitored.mfa_str] do %>
                  <button
                    phx-click="stop_capture"
                    phx-value-mfa={monitored.mfa_str}
                    class="btn btn-sm btn-error gap-2"
                    title="Stop capturing calls"
                  >
                    <.icon name="hero-stop" class="w-4 h-4" />
                    Stop
                  </button>
                <% else %>
                  <form phx-submit="start_capture" class="flex items-center gap-2">
                    <input type="hidden" name="mfa" value={monitored.mfa_str} />
                    <label class="text-xs font-medium">Threshold</label>
                    <input
                      type="number"
                      name="threshold"
                      value="0"
                      min="0"
                      class="input input-xs w-16"
                      title="Minimum call duration to capture (ms)"
                    />
                    <span class="text-xs">ms</span>
                    <label class="text-xs font-medium ml-2">Limit</label>
                    <input
                      type="number"
                      name="limit"
                      value="100"
                      min="1"
                      max="10000"
                      class="input input-xs w-16"
                      title="Maximum number of calls to capture"
                    />
                    <span class="text-xs">calls</span>
                    <button type="submit" class="btn btn-xs btn-success gap-1 ml-1">
                      <.icon name="hero-play" class="w-3 h-3" />
                      Start
                    </button>
                  </form>
                <% end %>
              </div>

              <%!-- Captured Data Display --%>
              <%= if @capture_data[monitored.mfa_str] do %>
                    <% capture = @capture_data[monitored.mfa_str] %>

                    <%!-- Capture Controls --%>
                    <div class="flex items-center gap-4 mb-4">
                      <div class="flex items-center gap-2">
                        <label class="text-sm font-medium">Threshold</label>
                        <input
                          type="number"
                          value={capture.spec.threshold}
                          class="input input-sm input-bordered w-20"
                          disabled
                        />
                        <span class="text-sm">ms</span>
                      </div>

                      <div class="flex items-center gap-2">
                        <label class="text-sm font-medium">Limit</label>
                        <input
                          type="number"
                          value={capture.spec.limit}
                          class="input input-sm input-bordered w-20"
                          disabled
                        />
                        <span class="text-sm">calls</span>
                      </div>
                    </div>

                    <%!-- Captured Calls Table --%>
                    <div class="overflow-x-auto">
                    <table class="table table-xs">
                      <thead>
                        <tr>
                          <th>No.</th>
                          <th>Call time</th>
                          <th>Pid</th>
                          <th>Function arguments</th>
                          <th>Return value</th>
                        </tr>
                      </thead>
                      <tbody>
                        <%= for item <- Enum.take(capture.items, capture.visible) do %>
                          <tr>
                            <td><%= item.id %></td>
                            <td><%= item.call_time %> µs</td>
                            <td class="font-mono text-xs"><%= item.pid %></td>
                            <td class="font-mono text-xs"><%= item.args %></td>
                            <td class="font-mono text-xs"><%= item.res %></td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                    <%= if length(capture.items) == 0 do %>
                      <div class="text-center py-8 text-sm opacity-50">
                        No calls captured yet
                      </div>
                    <% end %>
                    <%= if length(capture.items) > capture.visible do %>
                      <div class="text-center mt-2">
                        <button
                          phx-click="capture_more"
                          phx-value-mfa={monitored.mfa_str}
                          class="btn btn-xs btn-ghost"
                        >
                          Load more ({length(capture.items) - capture.visible} remaining)
                        </button>
                      </div>
                    <% end %>
                  </div>
              <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>

  <%!-- Callees Modal --%>
  <%= if @callees do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" phx-click="hide_callees">
      <div class="bg-base-100 rounded-xl shadow-2xl w-full max-w-lg mx-4 p-6" phx-click-away="hide_callees">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold">Functions called by <code class="font-mono text-sm"><%= @callees.mfa_str %></code></h3>
          <button phx-click="hide_callees" class="btn btn-xs btn-ghost">
            <.icon name="hero-x-mark" class="w-4 h-4" />
          </button>
        </div>
        <%= if @callees.list == [] do %>
          <p class="text-sm opacity-60 text-center py-4">No callees found (function may not be loaded or has no static call references).</p>
        <% else %>
          <p class="text-xs opacity-60 mb-2">Click a function to start monitoring it.</p>
          <ul class="space-y-1 max-h-80 overflow-y-auto">
            <%= for callee <- @callees.list do %>
              <li>
                <button
                  phx-click="monitor_callee"
                  phx-value-query={callee}
                  class="font-mono text-sm bg-base-200 hover:bg-base-300 rounded px-3 py-1.5 w-full text-left transition-colors cursor-pointer"
                >
                  <%= callee %>
                </button>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  <% end %>

  <%!-- Footer --%>
  <footer class="footer footer-center p-4 bg-base-300 text-base-content">
    <div>
      <p class="text-sm">
        XProf <%= if @mode, do: "- Mode: #{@mode}", else: "" %>
        | Status: <span class={[
          "font-semibold",
          if(@trace_status == "running", do: "text-success", else: "text-warning")
        ]}><%= @trace_status %></span>
      </p>
    </div>
  </footer>
</div>
